@page "/InlineSubject"
@using Phazor.Sample.Tools
@attribute [PhazorSample("InlineSubject")]

<PhazorInlineSubject T="bool" Context="subject">

    <button onclick="@(() => subject.OnNext(true))">
        Show
    </button>

    <PhazorReactiveValue Value="subject" Context="visible">

        <div hidden="@(!visible)">

            Content

            <button onclick="@(() => subject.OnNext(false))">
                Hide
            </button>

        </div>

    </PhazorReactiveValue>

</PhazorInlineSubject>